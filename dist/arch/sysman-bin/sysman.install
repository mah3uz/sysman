post_install() {
  echo '==> Start the collector for your user:'
  echo '      systemctl --user enable --now sysmand'
  echo '==> Optional: the privileged helper adds SMART drive health, CPU package power,'
  echo '    disk I/O and open files of other users processes, and per-process network'
  echo '    traffic. Turn it on in Settings in the app, or:'
  echo '      sudo systemctl enable --now sysman-helper'
}

post_upgrade() {
  echo '==> Restart the collector to run the new version:'
  echo '      systemctl --user restart sysmand'
  echo '==> If the privileged helper is enabled, restart it too:'
  echo '      sudo systemctl try-restart sysman-helper'
}

pre_remove() {
  echo '==> Stop the collector first if it is running:'
  echo '      systemctl --user disable --now sysmand'
  echo '==> and the privileged helper, if enabled:'
  echo '      sudo systemctl disable --now sysman-helper'
}
